root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

# The differential corpus is generated by a script and diffed as a whole; a
# reformat would produce a 5881-line diff that hides the rows that changed.
[src/testdata/*.json]
insert_final_newline = false
trim_trailing_whitespace = false
